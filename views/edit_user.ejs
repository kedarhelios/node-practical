<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Edit User</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootswatch@4.5.2/dist/flatly/bootstrap.min.css"
            integrity="sha384-qF/QmIAj5ZaYFAeQcrQ6bfVMAh4zZlrGwTPY7T/M+iTTLJqJBJjwwnsE5Y0mV7QK"
            crossorigin="anonymous"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    </head>
    <body class="bg-light">
        <div
            class="container d-flex justify-content-center align-items-center vh-100"
        >
            <div class="card shadow-lg p-4" style="width: 400px">
                <h1 class="text-center mb-4">Edit User</h1>

                <div
                    id="message"
                    class="mb-3 text-center"
                    style="font-size: 1.1rem"
                ></div>

                <div class="form-group">
                    <label for="name">Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        value="<%= user.name %>"
                        required
                    />
                    <div
                        id="name-error"
                        class="text-danger mt-2"
                        style="font-size: 0.875rem"
                    ></div>
                </div>

                <div class="form-group">
                    <label for="username">Username</label>
                    <input
                        type="text"
                        id="username"
                        name="username"
                        class="form-control"
                        value="<%= user.username %>"
                        required
                    />
                    <div
                        id="username-error"
                        class="text-danger mt-2"
                        style="font-size: 0.875rem"
                    ></div>
                </div>

                <button
                    id="saveChangesBtn"
                    class="btn btn-primary btn-block mt-3"
                >
                    Save Changes
                </button>

                <% if (!isCurrentUser) { %>
                <button
                    id="deleteUserBtn"
                    class="btn btn-danger btn-block mt-3"
                >
                    Delete User
                </button>
                <% } %>

                <!-- Delete Confirmation Modal -->
                <div
                    class="modal fade"
                    id="deleteConfirmModal"
                    tabindex="-1"
                    role="dialog"
                    aria-labelledby="deleteConfirmModalLabel"
                    aria-hidden="true"
                >
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header bg-danger text-white">
                                <h5
                                    class="modal-title"
                                    id="deleteConfirmModalLabel"
                                >
                                    Confirm Deletion
                                </h5>
                                <button
                                    type="button"
                                    class="close text-white"
                                    data-dismiss="modal"
                                    aria-label="Close"
                                >
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete this user? This
                                action cannot be undone.
                            </div>
                            <div class="modal-footer">
                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    data-dismiss="modal"
                                >
                                    Cancel
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-danger"
                                    id="confirmDeleteBtn"
                                >
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            $(document).ready(function () {
                let nameTouched = false;
                let usernameTouched = false;

                const validateField = (field, errorId, minLength) => {
                    const value = $(field).val().trim();
                    const errorMessageElement = $(errorId);

                    errorMessageElement.text("");

                    if (!value) {
                        errorMessageElement.text("This field is required.");
                        return false;
                    }
                    if (value.length < minLength) {
                        errorMessageElement.text(
                            `This field must be at least ${minLength} characters.`
                        );
                        return false;
                    }
                    return true;
                };

                $("#name")
                    .on("blur", function () {
                        nameTouched = true;
                        validateField("#name", "#name-error", 6);
                    })
                    .on("input", function () {
                        if (nameTouched) {
                            validateField("#name", "#name-error", 6);
                        }
                    });

                $("#username")
                    .on("blur", function () {
                        usernameTouched = true;
                        validateField("#username", "#username-error", 6);
                    })
                    .on("input", function () {
                        if (usernameTouched) {
                            validateField("#username", "#username-error", 6);
                        }
                    });

                const triggerBlurOnInputs = () => {
                    $("#name").blur();
                    $("#username").blur();
                };

                const clearErrors = () => {
                    $("#name-error").text("");
                    $("#username-error").text("");
                    $("#message").text("");
                };

                const triggerOnSubmit = () => {
                    clearErrors();
                    triggerBlurOnInputs();

                    let valid = true;
                    if (!validateField("#name", "#name-error", 6))
                        valid = false;
                    if (!validateField("#username", "#username-error", 6))
                        valid = false;

                    if (!valid) {
                        return;
                    }

                    const data = {
                        name: $("#name").val().trim(),
                        username: $("#username").val().trim(),
                    };

                    const token = localStorage.getItem("authToken");

                    $.ajax({
                        url: "/api/users/<%= user.id %>",
                        method: "PATCH",
                        contentType: "application/json",
                        data: JSON.stringify(data),
                        headers: {
                            Authorization: `Bearer ${token}`,
                        },
                        success: function (response) {
                            $("#message")
                                .css("color", "green")
                                .text("User updated successfully!");

                            window.location.href = "/users";
                        },
                        error: function (xhr) {
                            const res = xhr.responseJSON;
                            if (res && res.errors) {
                                if (res.errors.name) {
                                    $("#name-error").text(res.errors.name);
                                }
                                if (res.errors.username) {
                                    $("#username-error").text(
                                        res.errors.username
                                    );
                                }
                                if (res.errors.general) {
                                    $("#message")
                                        .css("color", "red")
                                        .text(res.errors.general);
                                }
                            } else {
                                $("#message")
                                    .css("color", "red")
                                    .text(
                                        "An error occurred. Please try again."
                                    );
                            }
                        },
                    });
                };

                $("#saveChangesBtn").click(function (e) {
                    e.preventDefault();
                    triggerOnSubmit();
                });

                $("#name, #username").keydown(function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        triggerOnSubmit();
                    }
                });

                $("#deleteUserBtn").on("click", function () {
                    $("#deleteConfirmModal").modal("show");
                });

                $("#confirmDeleteBtn").on("click", function () {
                    const token = localStorage.getItem("authToken");

                    $.ajax({
                        url: "/api/users/<%= user.id %>",
                        method: "DELETE",
                        headers: {
                            Authorization: `Bearer ${token}`,
                        },
                        success: function (response) {
                            $("#deleteConfirmModal").modal("hide");
                            window.location.href = "/users";
                        },
                        error: function () {
                            $("#deleteConfirmModal").modal("hide");
                            $("#message")
                                .css("color", "red")
                                .text(
                                    "Failed to delete user. Please try again."
                                );
                        },
                    });
                });
            });
        </script>
    </body>
</html>
