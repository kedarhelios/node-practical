<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Product Listing</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootswatch@4.5.2/dist/flatly/bootstrap.min.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
        <link
            href="https://cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
            rel="stylesheet"
        />
    </head>
    <body class="bg-light">
        <%- include('../partials/header', { user: user }) %>
        <div class="container mt-5">
            <h1 class="text-center mb-4">Products</h1>

            <button
                class="btn btn-primary mb-3"
                onclick="window.location.href='/products/add'"
            >
                Add New Product
            </button>

            <table id="productTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>Product Number</th>
                        <th>Name</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <script>
            $(document).ready(function () {
                const table = $("#productTable").DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: function (data, callback, settings) {
                        const page =
                            settings._iDisplayStart / settings._iDisplayLength +
                            1;
                        const limit = settings._iDisplayLength;
                        const search = settings.oPreviousSearch.sSearch;
                        const sortBy =
                            settings.aaSorting[0][0] === 0
                                ? "product_number"
                                : "name";
                        const order =
                            settings.aaSorting[0][1] === "asc" ? "ASC" : "DESC";

                        $.ajax({
                            url: "/api/products",
                            method: "GET",
                            data: {
                                page: page,
                                limit: limit,
                                search: search,
                                sortBy: sortBy,
                                order: order,
                            },
                            success: function (response) {
                                callback({
                                    draw: settings.iDraw,
                                    recordsTotal: response.pagination.total,
                                    recordsFiltered: response.pagination.total,
                                    data: response.data,
                                });
                            },
                            error: function (xhr, error, thrown) {
                                console.error("Error fetching data: ", error);
                            },
                        });
                    },
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    columns: [
                        { data: "product_number" },
                        { data: "name" },
                        { data: "created_at" },
                    ],
                    columnDefs: [
                        {
                            targets: [0, 1],
                            orderable: true,
                        },
                        {
                            targets: 2,
                            orderable: false,
                            render: function (data) {
                                return new Date(data).toLocaleDateString();
                            },
                        },
                    ],
                });
            });
        </script>
    </body>
</html>
