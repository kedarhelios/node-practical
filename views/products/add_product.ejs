<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Add Product</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootswatch@4.5.2/dist/flatly/bootstrap.min.css"
            integrity="sha384-qF/QmIAj5ZaYFAeQcrQ6bfVMAh4zZlrGwTPY7T/M+iTTLJqJBJjwwnsE5Y0mV7QK"
            crossorigin="anonymous"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    </head>
    <body class="bg-light">
        <%- include('../partials/header', { user: user }) %>
        <div
            class="container d-flex justify-content-center align-items-center vh-100"
        >
            <div class="card shadow-lg p-4" style="width: 400px">
                <h1 class="text-center mb-4">Add Product</h1>
                <div
                    id="message"
                    class="mb-3 text-center"
                    style="font-size: 1.1rem"
                ></div>

                <div>
                    <div class="form-group">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="form-control"
                            placeholder="Enter name"
                            required
                        />
                        <div
                            id="name-error"
                            class="text-danger mt-2"
                            style="font-size: 0.875rem"
                        ></div>
                    </div>
                    <div class="form-group">
                        <label for="price">Price</label>
                        <input
                            type="number"
                            id="price"
                            name="price"
                            class="form-control"
                            placeholder="Enter price"
                            required
                        />
                        <div
                            id="price-error"
                            class="text-danger mt-2"
                            style="font-size: 0.875rem"
                        ></div>
                    </div>
                    <button
                        id="addProduct"
                        type="submit"
                        class="btn btn-primary btn-block mt-3"
                    >
                        Add Product
                    </button>
                </div>
            </div>
        </div>

        <script>
            $(document).ready(function () {
                let nameTouched = false;
                let priceTouched = false;

                const validateField = (field, errorId, minLength) => {
                    const value = $(field).val().trim();
                    const errorMessageElement = $(errorId);

                    errorMessageElement.text("");

                    if (nameTouched || priceTouched) {
                        if (!value) {
                            errorMessageElement.text("This field is required.");
                            return false;
                        }
                        if (value.length < minLength) {
                            errorMessageElement.text(
                                `This field must be at least ${minLength} characters.`
                            );
                            return false;
                        }
                    }
                    return true;
                };

                const triggerBlurOnInputs = () => {
                    $("#name").blur();
                    $("#price").blur();
                };

                $("#name")
                    .on("blur", function () {
                        nameTouched = true;
                        validateField("#name", "#name-error", 6);
                    })
                    .on("input", function () {
                        if (nameTouched) {
                            validateField("#name", "#name-error", 6);
                        }
                    });

                $("#price")
                    .on("blur", function () {
                        priceTouched = true;
                        validateField("#price", "#price-error", 1);
                    })
                    .on("input", function () {
                        if (priceTouched) {
                            validateField("#price", "#price-error", 1);
                        }
                    });

                const triggerOnSubmit = () => {
                    let valid = true;

                    if (!validateField("#name", "#name-error", 6)) {
                        valid = false;
                    }
                    if (!validateField("#price", "#price-error", 1)) {
                        valid = false;
                    }

                    $("#message").text("");

                    const $message = $("#message");

                    const data = {
                        name: $("#name").val().trim(),
                        price: +$("#price").val().trim(),
                    };

                    if (valid) {
                        const csrfToken = "<%= csrfToken %>";

                        $.ajax({
                            url: "/api/products/",
                            method: "POST",
                            headers: {
                                "CSRF-Token": csrfToken,
                            },
                            contentType: "application/json",
                            data: JSON.stringify(data),
                            success: function (response) {
                                $message
                                    .css("color", "green")
                                    .text("Product added successfully!");
                                window.location.href = "/products";
                            },
                            error: function (xhr) {
                                const msg =
                                    xhr.responseJSON?.message ||
                                    "Something went wrong!";
                                $message.css("color", "red").text(msg);
                            },
                        });
                    }
                };

                $("#addProduct").click(function (e) {
                    e.preventDefault();
                    triggerBlurOnInputs();
                    triggerOnSubmit();
                });

                $("#name, #price, #addProduct").keydown(function (e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        triggerBlurOnInputs();
                        triggerOnSubmit();
                    }
                });
            });
        </script>
    </body>
</html>
