<!DOCTYPE html>
<html>
    <head>
        <title>Edit Product</title>
        <link
            rel="stylesheet"
            href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
        />
    </head>
    <body>
        <div class="container mt-5">
            <h1>Edit Product</h1>
            <form method="POST" action="/products/edit/<%= product.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <div class="form-group">
                    <label for="name">Name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="name"
                        name="name"
                        value="<%= product.name %>"
                        required
                        minlength="6"
                    />
                    <% if (errors.name) { %>
                    <small class="text-danger"><%= errors.name %></small>
                    <% } %>
                </div>
                <div class="form-group">
                    <label for="product_number">Product Number</label>
                    <input
                        type="text"
                        class="form-control"
                        id="product_number"
                        name="product_number"
                        value="<%= product.product_number %>"
                        required
                        pattern="\d+"
                        minlength="6"
                    />
                    <% if (errors.product_number) { %>
                    <small class="text-danger"
                        ><%= errors.product_number %></small
                    >
                    <% } %>
                </div>
                <div class="form-group">
                    <label for="price">Price (optional)</label>
                    <input
                        type="number"
                        step="0.01"
                        class="form-control"
                        id="price"
                        name="price"
                        value="<%= product.price %>"
                    />
                </div>
                <button type="submit" class="btn btn-primary">
                    Update Product
                </button>
                <a href="/products" class="btn btn-secondary">Cancel</a>
            </form>
            <form
                method="POST"
                action="/products/delete/<%= product.id %>"
                class="mt-3"
                onsubmit="return confirm('Are you sure you want to delete this product?');"
            >
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-danger">
                    Delete Product
                </button>
            </form>
        </div>
    </body>
</html>
