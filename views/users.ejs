<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>User Listing</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootswatch@4.5.2/dist/flatly/bootstrap.min.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
        <link
            href="https://cdn.datatables.net/1.12.1/css/jquery.dataTables.min.css"
            rel="stylesheet"
        />
    </head>
    <body class="bg-light">
        <div class="container mt-5">
            <h1 class="text-center mb-4">Users</h1>

            <button
                class="btn btn-primary mb-3"
                onclick="window.location.href='/users/add'"
            >
                Add New User
            </button>

            <table id="userTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Created At</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                    <tr
                        onclick="window.location.href='/users/edit/<%= user.id %>'"
                        class="cursor-pointer"
                    >
                        <td><%= user.name %></td>
                        <td><%= user.username %></td>
                        <td>
                            <%= user.created_at.toISOString().slice(0, 10) %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <script>
            $(document).ready(function () {
                $("#userTable").DataTable();
            });
        </script>
    </body>
</html>
